## Default .htaccess file

# HTTPS and www: everything goes to https://www.vlabidem.cz
# (X-Forwarded-Proto covers TLS terminated in front of Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.vlabidem.cz%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^vlabidem\.cz$ [NC]
  RewriteRule ^ https://www.vlabidem.cz%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
Redirect 301 /commisions.html /commissions.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml image/x-icon
</IfModule>

# Browser caching; CSS/JS have no version in their names, so keep it short
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Start with one day; raise to a year (31536000) once HTTPS has run without problems
  Header always set Strict-Transport-Security "max-age=86400" env=HTTPS
</IfModule>

# Build sources are not part of the site; block them if uploaded by mistake
RedirectMatch 404 ^/(src/|build\.py$|README\.md$|LICENSE$)
